<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ashfall.Core as its own assembly (as Unity's asmdef builds it), so internal members are not visible to the Unity scripts. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Ashfall.Core</AssemblyName>
    <NoWarn>CS0414;CS0649;CS0169;CS0067;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\Game\Assets\Ashfall\Core\**\*.cs" />
  </ItemGroup>
</Project>
